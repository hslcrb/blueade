{
  "name": "blueade",
  "productName": "Bluade",
  "version": "0.1.0",
  "description": "Bluade — a calm, clear archive companion / 압축의 모든 순간을 하나의 창에서",
  "license": "MIT",
  "author": "Bluade contributors",
  "homepage": "https://github.com/hslcrb/blueade",
  "repository": {
    "type": "git",
    "url": "https://github.com/hslcrb/blueade.git"
  },
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/zip/archive.js && node --check src/ui/app.js && npm test",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "dist:win:portable": "electron-builder --win zip --x64 --publish never",
    "build:asar": "node scripts/build-offline-asar.cjs",
    "build:win:portable:manual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/assemble-win32.ps1 -DownloadElectron"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "io.github.hslcrb.blueade",
    "productName": "Bluade",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/jszip/**/*",
      "node_modules/setimmediate/**/*",
      "node_modules/pako/**/*",
      "node_modules/lie/**/*",
      "node_modules/readable-stream/**/*",
      "node_modules/inherits/**/*",
      "node_modules/core-util-is/**/*",
      "node_modules/isarray/**/*",
      "node_modules/process-nextick-args/**/*",
      "node_modules/safe-buffer/**/*",
      "node_modules/string_decoder/**/*",
      "node_modules/util-deprecate/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Bluade-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": null
  }
}
